{
  "name": "modsym",
  "version": "0.2.2",
  "description": "Find the TypeScript declaration (.d.ts) for an exported symbol in an npm package — or truthfully abstain. Small CLI for coding agents.",
  "type": "module",
  "bin": {
    "modsym": "bin/modsym.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrmayurgithub/modsym.git"
  },
  "homepage": "https://github.com/mrmayurgithub/modsym#readme",
  "bugs": {
    "url": "https://github.com/mrmayurgithub/modsym/issues"
  },
  "keywords": [
    "typescript",
    "npm",
    "cli",
    "symbols",
    "declarations",
    "dts",
    "developer-tools",
    "coding-agents"
  ],
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "test/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "npm-package-arg": "^13.0.0",
    "pacote": "^21.0.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "test": "node --test test/resolve.test.js test/entry.test.js test/graph.test.js test/contract.test.js test/list.test.js",
    "test:corpora": "node scripts/test-corpora.mjs",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "test:real": "node scripts/real-corpus.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "devDependencies": {},
  "author": ""
}
